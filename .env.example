# Anthropic API key used for document field extraction
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the default extraction model
ANTHROPIC_MODEL=claude-sonnet-5

# Database connection string used by the backend.
# docker-compose sets this automatically for local dev (Postgres) -
# leave unset to fall back to a local SQLite file for a bare `uvicorn` run.
DATABASE_URL=postgresql://docsense:docsense@db:5432/docsense

# Comma-separated list of origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Base URL the frontend uses to reach the backend
VITE_API_BASE_URL=http://localhost:8000
